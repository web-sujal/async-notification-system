{
  "name": "async-notification-system",
  "version": "1.0.0",
  "description": "Async Notification System",
  "type": "module",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc",
    "start": "SERVICE_NAME=api node dist/src/index.js",
    "start:worker": "SERVICE_NAME=worker node dist/src/worker.js",
    "start:relay": "SERVICE_NAME=relay node dist/src/relay.js",
    "dev": "SERVICE_NAME=api tsx --watch src/index.ts",
    "dev:worker": "SERVICE_NAME=worker tsx --watch src/worker.ts",
    "dev:relay": "SERVICE_NAME=relay tsx --watch src/relay.ts",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "test": "NODE_ENV=test vitest run",
    "test:watch": "NODE_ENV=test vitest",
    "migration:run": "SERVICE_NAME=migrate tsx src/db/migrate.ts"
  },
  "keywords": [
    "express",
    "typescript",
    "async",
    "notification",
    "system"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@bull-board/api": "^7.1.5",
    "@bull-board/express": "^7.1.5",
    "bullmq": "^5.77.4",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "http-status-codes": "^2.3.0",
    "morgan": "^1.10.1",
    "postgres": "^3.4.9",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.9.1",
    "@types/supertest": "^7.2.0",
    "eslint": "^10.4.0",
    "globals": "^17.6.0",
    "prettier": "3.8.3",
    "supertest": "^7.2.2",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4",
    "vitest": "^4.1.7"
  }
}