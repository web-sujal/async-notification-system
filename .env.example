NODE_ENV=development
PORT=8080

# Comma-separated origins, or leave empty to allow all in development
# CORS_ORIGINS=http://localhost:3000,https://example.com

LOG_DIR=logs
LOG_LEVEL=info

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/async_notification_system
DATABASE_MAX_POOL=20

REDIS_URL=redis://localhost:6379

ENABLE_FAILURE_MODE=false
ENABLE_DELAY_MODE=false
DELAY_MODE_DELAY=500