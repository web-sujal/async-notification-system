# Docker Compose dev env — copy to .env.docker.development (gitignored)
# Used with: pnpm docker:dev

NODE_ENV=development
PORT=8080

LOG_DIR=logs
LOG_LEVEL=info

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=async_notification_system

DATABASE_URL=postgresql://postgres:postgres@db:5432/async_notification_system
DATABASE_MAX_POOL=20

REDIS_URL=redis://redis:6379

ENABLE_FAILURE_MODE=false
ENABLE_DELAY_MODE=false
DELAY_MODE_DELAY=500
